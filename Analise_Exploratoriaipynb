      },
      "source": [
        "\n",
        "\n",
        "# 1. Copiar dados expandidos e padronizar categorias para visualização\n",
        "df_analise_nova = expanded_balanced_df.copy()\n",
        "df_analise_nova['categoria_limpa'] = df_analise_nova['categoria'].astype(str).str.strip().str.lower()\n",
        "df_analise_nova['categoria_limpa'] = df_analise_nova['categoria_limpa'].replace({'': 'não informada', 'nan': 'não informada'})\n",
        "df_analise_nova['categoria_limpa'] = df_analise_nova['categoria_limpa'].str.capitalize()\n",
        "\n",
        "total_novo = len(df_analise_nova)\n",
        "\n",
        "# 2. Tabela de Frequência Consolidada de Categorias\n",
        "freq_nova = df_analise_nova['categoria_limpa'].value_counts().reset_index()\n",
        "freq_nova.columns = ['Categoria', 'Quantidade de Notícias']\n",
        "freq_nova['% do Corpus Total'] = (freq_nova['Quantidade de Notícias'] / total_novo) * 100\n",
        "\n",
        "print(\"=== NOVA VARIABILIDADE DE ASSUNTOS NO DATASET EXPANDIDO ===\")\n",
        "print(f\"Volume Total do Dataset: {total_novo} notícias\\n\")\n",
        "\n",
        "# Formatação para exibição elegante\n",
        "freq_nova_formatted = freq_nova.copy()\n",
        "freq_nova_formatted['Quantidade de Notícias'] = freq_nova_formatted['Quantidade de Notícias'].apply(lambda x: f\"{x:,.0f}\".replace(\",\", \".\"))\n",
        "freq_nova_formatted['% do Corpus Total'] = freq_nova_formatted['% do Corpus Total'].apply(lambda x: f\"{x:.1f}%\")\n",
        "display(freq_nova_formatted)\n",
        "\n",
        "# 3. Cruzamento entre Assuntos e Classes (Falsa vs Verdadeira)\n",
        "tabela_cruzada = pd.crosstab(df_analise_nova['categoria_limpa'], df_analise_nova['classe'], margins=True, margins_name='Total')\n",
        "tabela_cruzada = tabela_cruzada.sort_values(by='Total', ascending=False)\n",
        "print(\"\\n=== DISTRIBUIÇÃO DE CLASSES POR CATEGORIA ===\")\n",
        "display(tabela_cruzada)\n",
        "\n",
        "# 4. Plotagem da Variabilidade de Assuntos por Classe\n",
        "plt.figure(figsize=(12, 7))\n",
        "# Excluindo 'Não informada' para focar a visualização nos temas específicos\n",
        "df_grafico = df_analise_nova[df_analise_nova['categoria_limpa'] != 'Não informada']\n",
        "\n",
        "sns.countplot(\n",
        "    data=df_grafico,\n",
        "    y='categoria_limpa',\n",
        "    hue='classe',\n",
        "    order=df_grafico['categoria_limpa'].value_counts().index,\n",
        "    palette=['crimson', 'dodgerblue']\n",
        ")\n",
        "\n",
        "plt.title('Variabilidade de Assuntos do Novo Dataset por Classe (Categorias Informadas)', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Quantidade de Notícias')\n",
        "plt.ylabel('Categoria')\n",
        "plt.grid(axis='x', linestyle='--', alpha=0.5)\n",
        "plt.legend(title='Classe')\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
