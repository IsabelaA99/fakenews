        "### 🚀 Novo Benchmarking no Dataset Normalizado (`noticias_normalizadas_bertimbau.csv`)\n",
        "\n",
        "Vamos recalcular o TF-IDF e reavaliar a Regressão Logística e o XGBoost para ver o impacto real na acurácia e precisão após a eliminação dos atalhos estatísticos (*shortcut learning*)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 268
        },
        "id": "98a6a399",
        "outputId": "94a3d36d-43c8-4c26-8e0c-f448e8e36444"
      },
      "source": [
        "import time\n",
        "import warnings\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import accuracy_score, precision_score, f1_score\n",
        "\n",
        "# Suprimir alertas\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# 1. Carregar o dataset normalizado\n",
        "df_novo = pd.read_csv('/content/noticias_normalizadas_sem_dupl (1).csv')\n",
        "\n",
        "# Garantir que não há valores nulos\n",
        "df_novo['texto_limpo'] = df_novo['texto_limpo'].fillna('')\n",
        "\n",
        "# 2. Divisão de Treino (80%) e Teste (20%) estratificada\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    df_novo['texto_limpo'],\n",
        "    df_novo['label'],\n",
        "    test_size=0.2,\n",
        "    stratify=df_novo['label'],\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# 3. Vetorização TF-IDF\n",
        "vectorizer = TfidfVectorizer(max_features=10000, ngram_range=(1, 2))\n",
        "X_train_tfidf = vectorizer.fit_transform(X_train)\n",
        "X_test_tfidf = vectorizer.transform(X_test)\n",
        "\n",
        "# 4. Definir os modelos\n",
        "modelos_ml = {\n",
        "    'Regressão Logística': LogisticRegression(max_iter=1000, random_state=42),\n",
        "    'XGBoost': XGBClassifier(random_state=42, eval_metric='logloss')\n",
        "}\n",
        "\n",
        "resultados_ml = []\n",
        "\n",
        "# 5. Loop de Treinamento e Avaliação\n",
        "print(\"=== BENCHMARKING REFEITO: REGRESSÃO LOGÍSTICA VS XGBOOST ===\")\n",
        "for name, model in modelos_ml.items():\n",
        "    print(f\"\\nTreinando {name}...\")\n",
        "    start_time = time.time()\n",
        "\n",
        "    # Treino\n",
        "    model.fit(X_train_tfidf, y_train)\n",
        "    train_time = time.time() - start_time\n",
        "\n",
        "    # Predição\n",
        "    y_pred = model.predict(X_test_tfidf)\n",
        "\n",
        "    # Métricas\n",
        "    acc = accuracy_score(y_test, y_pred)\n",
        "    prec = precision_score(y_test, y_pred)\n",
        "    f1 = f1_score(y_test, y_pred)\n",
        "\n",
        "    resultados_ml.append({\n",
        "        'Modelo': name,\n",
        "        'Acurácia (%)': acc * 100,\n",
        "        'Precisão (%)': prec * 100,\n",
        "        'F1-Score': f1,\n",
        "        'Tempo de Treino (s)': train_time\n",
        "    })\n",
        "    print(f\"✓ {name} finalizado. Acurácia: {acc*100:.2f}% | Precisão: {prec*100:.2f}%\")\n",
        "\n",
        "# 6. Compilar Resultados\n",
        "df_resultados_ml = pd.DataFrame(resultados_ml)\n",
        "display(df_resultados_ml.sort_values(by='Acurácia (%)', ascending=False))"
      ],
