      },
      "source": [
        "import pandas as pd\n",
        "\n",
        "# 1. Carregar o arquivo final de treino\n",
        "df_auditoria = pd.read_csv('/content/noticias_normalizadas_bertimbau.csv')\n",
        "\n",
        "print(\"=== AUDITORIA DE INTEGRIDADE E UNICIDADE ===\")\n",
        "print(f\"Total de registros no dataset: {len(df_auditoria)}\")\n",
        "\n",
        "# 2. Contar duplicatas exatas na coluna 'texto_limpo'\n",
        "duplicatas_texto = df_auditoria.duplicated(subset=['texto_limpo']).sum()\n",
        "print(f\"-> Textos duplicados na coluna 'texto_limpo': {duplicatas_texto}\")\n",
        "\n",
        "# 3. Verificar se existem contradições (o mesmo texto classificado como falso E verdadeiro)\n",
        "contradicoes = df_auditoria.groupby('texto_limpo')['classe'].nunique()\n",
        "textos_contraditorios = contradicoes[contradicoes > 1].count()\n",
        "print(f\"-> Textos que aparecem como 'falsa' e 'verdadeira' ao mesmo tempo: {textos_contraditorios}\")\n",
        "\n",
        "# 4. Caso existam duplicatas residuais, vamos removê-las para garantir 100% de segurança\n",
        "if duplicatas_texto > 0 or textos_contraditorios > 0:\n",
        "    print(\"\\n⚠️ Atenção: Duplicatas detectadas! Iniciando limpeza forçada...\")\n",
        "\n",
        "    # Remove registros idênticos na coluna texto_limpo\n",
        "    df_auditoria = df_auditoria.drop_duplicates(subset=['texto_limpo']).copy()\n",
        "\n",
        "    # Garante o balanceamento rígido das classes novamente\n",
        "    min_size = df_auditoria['classe'].value_counts().min()\n",
        "    df_f = df_auditoria[df_auditoria['classe'] == 'falsa'].sample(n=min_size, random_state=42)\n",
        "    df_v = df_auditoria[df_auditoria['classe'] == 'verdadeira'].sample(n=min_size, random_state=42)\n",
        "\n",
        "    df_auditoria_limpo = pd.concat([df_f, df_v], ignore_index=True).sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "\n",
        "    # Sobrescreve o arquivo com a garantia absoluta de limpeza\n",
        "    df_auditoria_limpo.to_csv('/content/noticias_normalizadas_bertimbau.csv', index=False, encoding='utf-8')\n",
        "    print(f\"✓ Limpeza concluída! Novo tamanho do dataset balanceado e 100% único: {len(df_auditoria_limpo)} registros\")\n",
        "    print(df_auditoria_limpo['classe'].value_counts())\n",
        "else:\n",
        "    print(\"\\n✅ Sucesso absoluto! O dataset está 100% livre de duplicatas e pronto para o BERTimbau!\")"
