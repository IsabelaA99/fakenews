        "    cols_to_select = [col for col in common_columns if col in temp_df.columns]\n",
        "\n",
        "    # Reindexar com segurança agora que as colunas são únicas\n",
        "    df_temp = temp_df[cols_to_select].reindex(columns=common_columns)\n",
        "    unified_dfs.append(df_temp)\n",
        "\n",
        "# Concatenar todos os DataFrames de forma limpa\n",
        "combined_df = pd.concat(unified_dfs, ignore_index=True)\n",
