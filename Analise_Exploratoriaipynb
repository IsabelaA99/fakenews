      "source": [
        "processed_dfs = {}\n",
        "\n",
        "for name, df in dfs.items():\n",
        "    temp_df = df.copy()\n",
        "\n",
        "    # 1. Padronização de Colunas\n",
        "    column_mapping = {\n",
        "        'Titulo': 'titulo',\n",
        "        'Subtitulo': 'subtitulo',\n",
        "        'Noticia': 'texto',\n",
        "        'Categoria': 'categoria',\n",
        "        'Data': 'data',\n",
        "        'Autor': 'autor',\n",
        "        'URL': 'url',\n",
        "        'Classe': 'classe',\n",
        "        'title': 'titulo',\n",
        "        'text': 'texto',\n",
        "        'origin': 'origem',\n",
        "        'publisher_name': 'autor',\n",
        "        'publisher_site': 'origem'\n",
        "    }\n",
        "\n",
        "    temp_df = temp_df.rename(columns={k: v for k, v in column_mapping.items() if k in temp_df.columns})\n",
        "\n",
        "    # 2. Atribuir a coluna 'classe' de forma unificada\n",
        "    if 'Kaggle_Fakes' in name:\n",
        "        temp_df['classe'] = 'falsa'\n",
        "    elif 'Kaggle_True' in name:\n",
        "        temp_df['classe'] = 'verdadeira'\n",
        "\n",
