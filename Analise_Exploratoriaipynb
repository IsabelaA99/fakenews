        "## Tratamento do Desbalanceamento de Classes (Undersampling)"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 387
        },
        "id": "2d53404d",
        "outputId": "a886029d-5226-4432-af88-4334d757b14a"
      },
      "source": [
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Separar as classes\n",
        "df_falsas = combined_df[combined_df['classe'] == 'falsa']\n",
        "df_verdadeiras = combined_df[combined_df['classe'] == 'verdadeira']\n",
        "\n",
        "# Determinar o tamanho da classe minoritária\n",
        "n_samples = len(df_verdadeiras)\n",
        "\n",
        "# Realizar amostragem aleatória simples (undersampling) da classe majoritária\n",
        "df_falsas_balanced = df_falsas.sample(n=n_samples, random_state=42)\n",
        "\n",
        "# Concatenar novamente os DataFrames para formar o dataset balanceado\n",
        "balanced_df = pd.concat([df_falsas_balanced, df_verdadeiras], ignore_index=True)\n",
        "\n",
        "# Embaralhar os dados de forma que não fiquem ordenados por classe\n",
        "balanced_df = balanced_df.sample(frac=1, random_state=42).reset_index(drop=True)\n",
        "\n",
        "print(\"=== DATASET BALANCEADO ===\")\n",
        "print(f\"Total de registros: {balanced_df.shape[0]}\")\n",
        "print(f\"Distribuição de classes:\\n{balanced_df['classe'].value_counts()}\")\n",
        "\n",
        "# Visualizar a nova distribuição balanceada\n",
        "plt.figure(figsize=(6, 4))\n",
        "sns.countplot(data=balanced_df, x='classe', hue='classe', palette=['crimson', 'dodgerblue'], legend=False)\n",
        "plt.title('Distribuição de Classes Após Undersampling')\n",
        "plt.xlabel('Classe')\n",
        "plt.ylabel('Quantidade de Registros')\n",
        "plt.show()"
      ],
