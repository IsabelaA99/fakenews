      "source": [
        "# Vamos analisar o comprimento médio dos textos/títulos para entender a densidade de informação\n",
        "for name, df in dfs.items():\n",
        "    print(f\"\\n--- Análise Estatística de Texto: {name} ---\")\n",
        "    # Identificando a coluna de texto principal (comum ser 'text', 'texto', 'preprocessed_news' ou similar)\n",
        "    text_col = [col for col in df.columns if col.lower() in ['text', 'texto', 'preprocessed_news', 'title', 'titulo', 'noticia']]\n",
        "    if text_col:\n",
        "        target_col = text_col[0]\n",
        "        df['char_count'] = df[target_col].astype(str).apply(len)\n",
        "        df['word_count'] = df[target_col].astype(str).apply(lambda x: len(x.split()))\n",
        "        print(f\"Coluna de texto analisada: '{target_col}'\")\n",
        "        display(df[['char_count', 'word_count']].describe())\n",
        "    else:\n",
        "        print(\"Nenhuma coluna de texto óbvia encontrada para análise de comprimento.\")"
      ],
