        "# 3. Combinar todos os datasets em um único DataFrame\n",
        "\n",
        "# Selecionar as colunas comuns que queremos manter para o dataset unificado\n",
        "common_columns = ['titulo', 'texto', 'classe', 'url', 'data', 'autor', 'categoria', 'subtitulo', 'origem']\n",
        "\n",
        "unified_dfs = []\n",
        "for name, df in processed_dfs.items():\n",
        "    temp_df = df.copy()\n",
        "\n",
        "    # Resolver colunas duplicadas (ex: se há mais de uma coluna 'origem' devido ao mapeamento)\n",
        "    # Mantemos apenas a primeira aparição de cada coluna duplicada\n",
        "    temp_df = temp_df.loc[:, ~temp_df.columns.duplicated()]\n",
        "\n",
