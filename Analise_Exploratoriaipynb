      "source": [
        "import re\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. Carregar o Dataset\n",
        "nome_arquivo = '/content/noticias_balanceadas_expandidas_limpas.csv'\n",
        "df = pd.read_csv(nome_arquivo)\n",
        "\n",
        "print(f\"Total de registros carregados: {len(df)}\")\n",
        "print(df['classe'].value_counts())\n",
        "\n",
        "# 2. Função de Limpeza de Prefixos de Checagem (Fact-Checking Boilers)\n",
        "def limpar_prefixos_checagem(texto):\n",
        "    if not isinstance(texto, str):\n",
        "        return \"\"\n",
        "\n",
        "    t = texto.strip()\n",
        "\n",
        "    padroes = [\n",
        "        r'^(É falso que|É mentira que|É fake que|Falso que|Mentira que|Fake que)\\s*',\n",
        "        r'^(Fact Check\\.?|Fact Check:|Fato ou Fake:?|Checamos:?|Verificamos:?)\\s*',\n",
        "        r'^(Boato\\s*[-–:]|#boato\\b)',\n",
        "        r'(\\s*#boato\\b|\\s*\\[FALSO\\]|\\s*\\(FALSO\\)|\\s*\\[VERDADEIRO\\])',\n",
        "        r'^\\s*[\"“\\']|[\"”\\']\\s*$',\n",
        "    ]\n",
        "\n",
        "    for padrao in padroes:\n",
        "        t = re.sub(padrao, '', t, flags=re.IGNORECASE).strip()\n",
        "\n",
        "    # Remove espaços duplicados\n",
        "    t = re.sub(r'\\s+', ' ', t).strip()\n",
        "    return t\n",
        "\n",
        "# 3. Processamento e Normalização dos Textos\n",
        "df['texto_limpo'] = df['titulo'].apply(limpar_prefixos_checagem)\n",
        "\n",
        "# Filtrar títulos muito curtos ou vazios\n",
        "df = df[df['texto_limpo'].str.split().str.len() >= 4].copy()\n",
        "\n",
        "# Mapear Labels Numéricos (0 = falsa, 1 = verdadeira)\n",
        "df['label'] = df['classe'].map({'falsa': 0, 'verdadeira': 1})\n",
        "\n",
        "# 4. Cálculo de Estatísticas de Comprimento de Palavras\n",
        "df['num_palavras'] = df['texto_limpo'].str.split().str.len()\n",
        "\n",
        "print(\"\\n\" + \"=\"*50)\n",
        "print(\"📊 MÉTRICAS DE COMPRIMENTO DE PALAVRAS APÓS NORMALIZAÇÃO:\")\n",
        "print(\"=\"*50)\n",
        "metricas = df.groupby('classe')['num_palavras'].agg(['count', 'mean', 'median', 'std', 'min', 'max'])\n",
        "display(metricas)\n",
        "\n",
        "# 5. Gerar Gráfico de Comparação das Classes Normalizadas\n",
        "plt.figure(figsize=(9, 5))\n",
        "sns.barplot(data=df, x='classe', y='num_palavras', estimator=np.mean, errorbar=None, palette=['#fc8d62', '#66c2a5'])\n",
        "plt.title('Comprimento Médio de Palavras por Classe (Normalizado)', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Classe da Notícia', fontsize=12)\n",
        "plt.ylabel('Média de Palavras', fontsize=12)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "plt.show()\n",
        "\n",
        "# 6. Salvar Novo Dataset Normalizado\n",
        "arquivo_saida = '/content/noticias_normalizadas_bertimbau.csv'\n",
        "df_final = df[['texto_limpo', 'classe', 'label']].reset_index(drop=True)\n",
        "df_final.to_csv(arquivo_saida, index=False, encoding='utf-8')\n",
        "\n",
        "print(f\"\\n✅ Dataset normalizado salvo com sucesso em: '{arquivo_saida}'\")\n",
        "print(f\"Total de registros balanceados: {len(df_final)}\")"
      ],
