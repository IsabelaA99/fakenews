        "## Comparação de Comprimento de Textos: Média vs Mediana\n",
        "Análise visual do impacto de outliers no tamanho dos textos das notícias falsas e verdadeiras."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 354
        },
        "id": "1df2cf11",
        "outputId": "837ecd61-cbee-4814-ebb5-8c606aaa62d7"
      },
      "source": [
        "\n",
        "# 1. Calcular o comprimento (número de palavras) para cada registro no dataset balanceado\n",
        "balanced_df['comprimento_palavras'] = balanced_df['texto'].apply(lambda x: len(str(x).split()))\n",
        "\n",
        "# 2. Agrupar por classe e calcular a média e a mediana\n",
        "estatisticas = balanced_df.groupby('classe')['comprimento_palavras'].agg(['mean', 'median']).reset_index()\n",
        "print(\"=== MÉTRICAS DE COMPRIMENTO DE PALAVRAS ===\")\n",
        "display(estatisticas)\n",
        "\n",
        "# 3. Preparar os dados para plotagem no formato longo (long format)\n",
        "df_melted = estatisticas.melt(id_vars='classe', value_vars=['mean', 'median'],\n",
        "                             var_name='Metrica', value_name='Palavras')\n",
        "\n",
        "# Mapear os nomes das métricas para exibição amigável\n",
        "df_melted['Metrica'] = df_melted['Metrica'].map({'mean': 'Média', 'median': 'Mediana'})\n",
        "\n",
        "# 4. Criar o gráfico comparativo\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.barplot(data=df_melted, x='classe', y='Palavras', hue='Metrica', palette='Set2')\n",
        "\n",
        "plt.title('Comparação do Comprimento dos Textos: Média vs Mediana', fontsize=14, fontweight='bold')\n",
        "plt.xlabel('Classe da Notícia', fontsize=12)\n",
        "plt.ylabel('Quantidade de Palavras', fontsize=12)\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.5)\n",
        "plt.legend(title='Métrica')\n",
        "\n",
        "# Adicionar os rótulos de valores no topo das barras\n",
        "for p in plt.gca().patches:\n",
        "    height = p.get_height()\n",
        "    if height > 0:\n",
        "        plt.gca().annotate(f'{height:.1f}',\n",
        "                            (p.get_x() + p.get_width() / 2., height),\n",
        "                            ha='center', va='bottom', fontsize=10,\n",
        "                            xytext=(0, 5), textcoords='offset points')\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "# Remover coluna temporária para manter o DataFrame limpo\n",
        "balanced_df.drop(columns=['comprimento_palavras'], errors='ignore', inplace=True)"
      ],
